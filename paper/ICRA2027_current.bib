@article{zhangDynamicEventTriggeredControl2026,
  title = {Dynamic {{Event-Triggered Control}} for {{Human}}--{{Machine Cooperative Systems Based}} on {{Dynamic Authority Allocation}}},
  author = {Zhang, Dehua and Meng, Lei and Liang, Linlin and Qin, Chunbin and Liu, Derong},
  year = 2026,

# Stable launcher settings for scripts/start_hand_control_session.sh.
# Physical E-stop readiness and execution confirmation must remain CLI flags.
HAND_ARM=right
HAND_MODEL=O6
# Select the bus opposite the LinkerTA interface announced on
# /linkerta/can_interface.  This avoids assuming the O6 is always can1.
HAND_CAN_INTERFACE=auto
HAND_PRESET_CONFIG=config/hand_presets.json
HAND_LOG_DIR=/tmp/teleop_hand_control_logs

# Task3 (screwdriver alignment) capture defaults.
# Real-hardware safety confirmations remain explicit CLI flags.
CAPTURE_REAL=false
CAPTURE_ARMS=right
CAPTURE_SESSION=teleop_capture
CAPTURE_EPISODES=0
CAPTURE_MANUAL_SEGMENTS=true
CAPTURE_DURATION_S=30
CAPTURE_CAMERA_SERIAL=261722075670
CAPTURE_CAMERA_NAMESPACE=/camera/camera
CAPTURE_SECOND_CAMERA_SERIAL=327122074150
CAPTURE_SECOND_CAMERA_NAMESPACE=/camera2/camera
CAPTURE_WIDTH=640
CAPTURE_HEIGHT=480
CAPTURE_FPS=15
CAPTURE_TASK_PROFILE=config/tasks/screwdriver_alignment_v1/task.yaml
CAPTURE_TASK_ID=screwdriver_alignment_v1
CAPTURE_OPERATOR_ID=operator_01
CAPTURE_AUDITOR_ID=auditor_01
export TELEOP_ANNOTATION_EVENT_MAP='{"1":"approach","2":"align","3":"verify","4":"correction_toggle","5":"stalled_or_misaligned","6":"recovery_start","7":"target_lost","8":"retreat","9":"terminal_success","0":"terminal_failure"}'
CAPTURE_NO_PREVIEW=false
CAPTURE_EXPERIMENT_PROFILE=config/experiments/precision_assembly_ab.yaml
CAPTURE_CONDITION_ID=unassigned
CAPTURE_HAND_SDK=false
CAPTURE_LEFT_HAND_CAN=can0
CAPTURE_RIGHT_HAND_CAN=can1
CAPTURE_LEFT_TOUCH=false
CAPTURE_RIGHT_TOUCH=false
CAPTURE_LEARNED_FILTER_CONFIG=
CAPTURE_MODEL_DEPLOYMENT_CONFIG=config/runtime/model_deployment.yaml
# Task3 data root on the Seagate Hub external disk.
CAPTURE_DATA_ROOT="/media/fanshihao/Seagate Hub/ICRA2027/task3_Data"
